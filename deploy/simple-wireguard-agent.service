[Unit]
Description=Simple-WireGuard privileged agent (minimal command set)
After=network-online.target
Before=simple-wireguard.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /opt/simple-wireguard/agent/swg_agent.py
Restart=on-failure
RestartSec=3
RuntimeDirectory=simple-wireguard
RuntimeDirectoryMode=0755
UMask=0077
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=no
ProtectSystem=full
ReadWritePaths=/etc/wireguard /var/log/simple-wireguard /run/simple-wireguard

[Install]
WantedBy=multi-user.target
