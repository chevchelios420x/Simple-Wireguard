# Managed by Simple-WireGuard install.sh
/var/log/simple-wireguard/app.log /var/log/simple-wireguard/agent.log {
    daily
    rotate 30
    maxsize 50M
    missingok
    notifempty
    compress
    delaycompress
    dateext
    su swg swg
    create 0640 swg swg
}

# Audit trail is kept for one year.
/var/log/simple-wireguard/audit.log {
    weekly
    rotate 52
    maxsize 50M
    missingok
    notifempty
    compress
    delaycompress
    dateext
    su swg swg
    create 0640 swg swg
}

/var/log/simple-wireguard/nginx-access.log /var/log/simple-wireguard/nginx-error.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    dateext
    su root adm
    create 0640 www-data adm
    sharedscripts
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)" || true
    endscript
}
